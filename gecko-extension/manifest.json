{
  "manifest_version": 3,
  "name": "Translate+",
  "version": "1.2.1",
  "description": "Select text on any page and get an instant translation. Google, Bing, Groq, Polza or Gemini.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Translate+",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://translate.googleapis.com/*",
    "https://www.bing.com/*",
    "https://api.groq.com/*",
    "https://polza.ai/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "translate-plus@neodym121",
      "strict_min_version": "140.0",
      "update_url": "https://raw.githubusercontent.com/neodym121/translate-plus/main/updates.json",
      "data_collection_permissions": {
        "required": ["websiteContent"]
      }
    }
  }
}
